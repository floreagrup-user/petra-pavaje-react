# Cloudflare Pages redirects
# Old WordPress URLs (petrapavaje.ro) -> new React Router routes
# NOTE: Cloudflare Pages uses Netlify-style _redirects syntax. A wildcard
# capture in the destination MUST use ":splat" -- a bare "*" in the
# destination is treated as a literal character and will not match any
# route (this previously broke every product/category redirect below).

# ---------------------------------------------------------------------------
# Product categories & individual products
#
# These routes now live at the SAME path as the old WordPress site (e.g.
# /pavaje-premium/roca/ resolves directly, no redirect, no /produse/ prefix)
# -- see src/router.tsx and src/lib/product-urls.ts. Nothing to redirect
# there. The rules below are only a safety net for the brief window this
# session used a /produse/<category>/... structure, in case any of those
# interim links got bookmarked or shared.
# ---------------------------------------------------------------------------

/produse/pavaje-premium/* /pavaje-premium/:splat 301
/produse/pavaje-standard/quatro/* /pavaje-standard/quatro/:splat 301
/produse/pavaje-standard/* /pavaje-standard/:splat 301
/produse/woodstone/* /woodstone-lemn-pietrificat/:splat 301
/produse/borduri/* /borduri/:splat 301
/produse/boltari/* /boltari 301
/produse/rigole/* /rigole 301
/produse/jardiniere/* /jardiniere 301
/produse/palisada/* /palisada 301
/produse/banci/* /banci 301
